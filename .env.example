# GEMINI_API_KEY: Required for Gemini AI API calls (optional, not used in KoreaCiv).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SGIS OpenAPI (국가데이터처 통계지리정보서비스)
# 서비스 ID (Consumer Key) & 보안 Key (Consumer Secret)
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# KOSIS OpenAPI (국가데이터처 국가통계포털 인증키)
KOSIS_API_KEY=

# VWorld OpenAPI (국토교통부 브이월드 공간정보·지오코딩 API 키)
VWORLD_API_KEY=

# 공공데이터포털 (data.go.kr) 일반 인증키 — 무역항/공항 수송실적/대학알리미
DATA_GO_KR_SERVICE_KEY=
